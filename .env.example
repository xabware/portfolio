# Firebase environment variables
# Copy this file to .env.local and fill in your Firebase project values
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Analytics are disabled unless this is exactly "true"
VITE_ANALYTICS_ENABLED=false

# Firebase CMS reads are disabled unless this is exactly "true"
VITE_FIREBASE_CMS_ENABLED=false

# Public base path for static assets.
# Use /portfolio/ for GitHub Pages project sites, or / for root domains.
VITE_BASE_PATH=/portfolio/
